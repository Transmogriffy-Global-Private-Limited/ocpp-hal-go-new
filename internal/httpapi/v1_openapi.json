{
  "openapi": "3.0.3",
  "info": {"title": "OCPP HAL v1 Integration API", "version": "1.3.0", "description": "HAL-owned OCPP command, transaction, runtime, and immutable fact truth. CMS business policy remains outside this API."},
  "servers": [{"url": "http://127.0.0.1:18080"}],
  "components": {
    "securitySchemes": {"CMSServiceBearer": {"type": "http", "scheme": "bearer", "description": "Opaque HAL_V1_CMS_BEARER_TOKEN. Use TLS/private network outside local development."}},
    "parameters": {"IdempotencyKey": {"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","format":"uuid","description":"Canonical lowercase nonzero UUID."}}, "Correlation": {"name":"X-Correlation-ID","in":"header","required":true,"schema":{"type":"string","format":"uuid","description":"Canonical lowercase nonzero UUID."}}},
    "schemas": {
      "Error": {"type":"object","properties":{"error":{"type":"string"}}},
      "StartCommand": {"type":"object","required":["cms_command_id","cms_start_intent_id","cpo_id","customer_id","cms_charger_id","cms_connector_id","charger_ocpp_identity","ocpp_connector_number","id_tag","credential_expires_at","command_expires_at","energy_limit_wh","max_duration_seconds"],"properties":{"cms_command_id":{"type":"string","format":"uuid"},"cms_start_intent_id":{"type":"string","format":"uuid"},"cpo_id":{"type":"string","format":"uuid"},"customer_id":{"type":"string","format":"uuid","description":"Opaque CMS correlation only"},"cms_charger_id":{"type":"string","format":"uuid"},"cms_connector_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string"},"ocpp_connector_number":{"type":"integer","minimum":1},"id_tag":{"type":"string","description":"Short-lived appv1_ credential; never a customer identity"},"credential_expires_at":{"type":"string","format":"date-time"},"command_expires_at":{"type":"string","format":"date-time"},"energy_limit_wh":{"type":"integer","format":"int64","minimum":1,"description":"Integer Wh"},"max_duration_seconds":{"type":"integer","format":"int64","minimum":1}}},
      "StopCommand": {"type":"object","required":["cms_command_id","cms_charging_session_id","cpo_id","cms_charger_id","cms_connector_id","charger_ocpp_identity","ocpp_connector_number","hal_transaction_id","ocpp_transaction_id","requested_stop_initiator","requested_stop_reason","command_expires_at"],"properties":{"cms_command_id":{"type":"string","format":"uuid"},"cms_charging_session_id":{"type":"string","format":"uuid","description":"Opaque CMS correlation only"},"cpo_id":{"type":"string","format":"uuid"},"customer_id":{"type":"string","format":"uuid","description":"Optional opaque CMS correlation"},"cms_charger_id":{"type":"string","format":"uuid"},"cms_connector_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string"},"ocpp_connector_number":{"type":"integer","minimum":1},"hal_transaction_id":{"type":"string","format":"uuid"},"ocpp_transaction_id":{"type":"integer","format":"int64","minimum":1},"requested_stop_initiator":{"type":"string","enum":["CUSTOMER","CPO"]},"requested_stop_reason":{"type":"string"},"command_expires_at":{"type":"string","format":"date-time"}}},
      "Command": {"type":"object","description":"Canonical durable command projection. HAL command identity is established before OCPP dispatch; accepted delivery is not physical charging proof.","required":["hal_command_id","cms_command_id","kind","state","hal_transaction_id","ocpp_transaction_id","updated_at"],"properties":{"hal_command_id":{"type":"string","format":"uuid","description":"HAL-issued nonzero command identity."},"cms_command_id":{"type":"string","format":"uuid","description":"Exact CMS command identity supplied by the caller."},"kind":{"type":"string","enum":["START","STOP"]},"state":{"type":"string","enum":["PERSISTED","PENDING_DELIVERY","DELIVERY_ATTEMPTED","OCPP_ACCEPTED","OCPP_REJECTED","AMBIGUOUS","MATERIALIZED","SUPERSEDED"]},"hal_transaction_id":{"type":"string","format":"uuid","nullable":true,"description":"Present after an exact HAL transaction is established."},"ocpp_transaction_id":{"type":"integer","format":"int64","nullable":true,"minimum":1,"description":"Present after an exact OCPP transaction is established."},"updated_at":{"type":"string","format":"date-time"}}},
      "CommandEnvelope": {"type":"object","required":["command"],"properties":{"command":{"$ref":"#/components/schemas/Command"},"correlation_id":{"type":"string","format":"uuid"},"duplicate":{"type":"boolean"}}},
      "MappingRequest": {"type":"object","required":["cpo_id","cms_charger_id","charger_ocpp_identity","enabled","connectors"],"properties":{"cpo_id":{"type":"string","format":"uuid"},"cms_charger_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string","minLength":1},"enabled":{"type":"boolean"},"connectors":{"type":"array","minItems":1,"items":{"type":"object","required":["cms_connector_id","ocpp_connector_number"],"properties":{"cms_connector_id":{"type":"string","format":"uuid"},"ocpp_connector_number":{"type":"integer","minimum":1}}}}}},
      "Mapping": {"type":"object","required":["cpo_id","cms_charger_id","charger_ocpp_identity","enabled","connectors"],"properties":{"cpo_id":{"type":"string","format":"uuid"},"cms_charger_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string"},"enabled":{"type":"boolean"},"connectors":{"type":"array","items":{"type":"object","required":["cpo_id","cms_charger_id","cms_connector_id","charger_ocpp_identity","ocpp_connector_number"],"properties":{"cpo_id":{"type":"string","format":"uuid"},"cms_charger_id":{"type":"string","format":"uuid"},"cms_connector_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string"},"ocpp_connector_number":{"type":"integer","minimum":1}}}}}},
      "MappingEnvelope": {"type":"object","required":["mapping","idempotency_key","correlation_id"],"properties":{"mapping":{"$ref":"#/components/schemas/Mapping"},"idempotency_key":{"type":"string","format":"uuid"},"correlation_id":{"type":"string","format":"uuid"}}},
      "StopWorkflow": {"type":"object","required":["hal_transaction_id","requested_stop_initiator","requested_stop_reason","state","delivery_attempts","last_ocpp_result","last_error_category","created_at","updated_at"],"properties":{"hal_transaction_id":{"type":"string","format":"uuid"},"requested_stop_initiator":{"type":"string","enum":["CUSTOMER","CPO","ENERGY_LIMIT","TIME_LIMIT","SYSTEM_RECOVERY"]},"requested_stop_reason":{"type":"string"},"state":{"type":"string","enum":["PERSISTED","PENDING_DELIVERY","DELIVERY_ATTEMPTED","OCPP_ACCEPTED","OCPP_REJECTED","AMBIGUOUS","COMPLETED","SUPERSEDED"]},"delivery_attempts":{"type":"integer","minimum":0},"last_ocpp_result":{"type":"string"},"last_error_category":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time","nullable":true}}},
      "Transaction": {"type":"object","required":["hal_transaction_id","cms_start_intent_id","cms_command_id","cpo_id","cms_charger_id","cms_connector_id","charger_ocpp_identity","ocpp_connector_number","ocpp_transaction_id","actual_started_at","observed_started_at","meter_start_wh","meter_sequence","stop_state"],"properties":{"hal_transaction_id":{"type":"string","format":"uuid"},"cms_start_intent_id":{"type":"string","format":"uuid"},"cms_command_id":{"type":"string","format":"uuid"},"cpo_id":{"type":"string","format":"uuid"},"cms_charger_id":{"type":"string","format":"uuid"},"cms_connector_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string"},"ocpp_connector_number":{"type":"integer","minimum":1},"ocpp_transaction_id":{"type":"integer","format":"int64","minimum":1},"actual_started_at":{"type":"string","format":"date-time","description":"Charger protocol timestamp, accepted only within HAL plausibility policy."},"observed_started_at":{"type":"string","format":"date-time","description":"Trusted HAL receipt time used for expiry and duration enforcement."},"meter_start_wh":{"type":"integer","format":"int64","minimum":0},"latest_meter_wh":{"type":"integer","format":"int64","nullable":true},"consumed_wh":{"type":"integer","format":"int64","minimum":0,"nullable":true},"meter_observed_at":{"type":"string","format":"date-time","nullable":true},"meter_sequence":{"type":"integer","format":"int64","minimum":0},"energy_limit_wh":{"type":"integer","format":"int64","nullable":true},"max_duration_seconds":{"type":"integer","format":"int64","nullable":true},"stop_deadline_at":{"type":"string","format":"date-time","nullable":true},"stop_state":{"type":"string","enum":["NONE","PERSISTED","PENDING_DELIVERY","DELIVERY_ATTEMPTED","OCPP_ACCEPTED","OCPP_REJECTED","AMBIGUOUS","COMPLETED","SUPERSEDED"]},"requested_stop_initiator":{"type":"string","nullable":true},"requested_stop_reason":{"type":"string","nullable":true},"ocpp_stop_reason":{"type":"string","nullable":true},"completed_at":{"type":"string","format":"date-time","nullable":true},"observed_completed_at":{"type":"string","format":"date-time","nullable":true},"meter_stop_wh":{"type":"integer","format":"int64","nullable":true}}},
      "TransactionEnvelope": {"type":"object","required":["transaction"],"properties":{"transaction":{"$ref":"#/components/schemas/Transaction"},"stop_workflow":{"$ref":"#/components/schemas/StopWorkflow","nullable":true}}},
      "StopCommandEnvelope": {"type":"object","required":["command"],"properties":{"command":{"$ref":"#/components/schemas/Command"},"stop_workflow":{"$ref":"#/components/schemas/StopWorkflow","nullable":true},"correlation_id":{"type":"string","format":"uuid"},"duplicate":{"type":"boolean"}}},
      "ConnectorRuntime": {"type":"object","required":["cpo_id","cms_charger_id","cms_connector_id","charger_ocpp_identity","ocpp_connector_number","status","error_code","info","vendor_id","vendor_error_code","status_sequence","updated_at"],"properties":{"cpo_id":{"type":"string","format":"uuid"},"cms_charger_id":{"type":"string","format":"uuid"},"cms_connector_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string"},"ocpp_connector_number":{"type":"integer","minimum":1},"status":{"type":"string"},"error_code":{"type":"string"},"info":{"type":"string"},"vendor_id":{"type":"string"},"vendor_error_code":{"type":"string"},"observed_at":{"type":"string","format":"date-time","nullable":true},"status_sequence":{"type":"integer","format":"int64","minimum":0},"updated_at":{"type":"string","format":"date-time"}}},
      "ChargerRuntime": {"type":"object","required":["cpo_id","cms_charger_id","charger_ocpp_identity","connection_state","connection_generation","connection_sequence","updated_at","connectors"],"properties":{"cpo_id":{"type":"string","format":"uuid"},"cms_charger_id":{"type":"string","format":"uuid"},"charger_ocpp_identity":{"type":"string"},"connection_state":{"type":"string","enum":["ONLINE","OFFLINE","UNKNOWN"]},"connection_generation":{"type":"integer","format":"int64","minimum":0},"connection_sequence":{"type":"integer","format":"int64","minimum":0},"connected_at":{"type":"string","format":"date-time","nullable":true},"last_observed_at":{"type":"string","format":"date-time","nullable":true},"updated_at":{"type":"string","format":"date-time"},"connectors":{"type":"array","items":{"$ref":"#/components/schemas/ConnectorRuntime"}}}},
      "ChargerRuntimeEnvelope": {"type":"object","required":["runtime","fresh"],"properties":{"runtime":{"$ref":"#/components/schemas/ChargerRuntime"},"fresh":{"type":"boolean"}}},
      "ConnectorRuntimeEnvelope": {"type":"object","required":["runtime","fresh"],"properties":{"runtime":{"$ref":"#/components/schemas/ConnectorRuntime"},"fresh":{"type":"boolean"}}}
    }
  },
  "paths": {
    "/v1/mappings/chargers/{cms_charger_id}": {"put": {"summary":"Idempotently enroll an immutable CMS to OCPP charger/connector mapping", "security":[{"CMSServiceBearer":[]}], "parameters":[{"name":"cms_charger_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/Correlation"}], "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MappingRequest"}}}}, "responses":{"200":{"description":"Existing compatible mapping","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MappingEnvelope"}}}},"201":{"description":"Mapping enrolled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MappingEnvelope"}}}},"401":{"description":"Missing or invalid service credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Conflicting mapping","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid mapping","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
    "/v1/remote-commands/start": {"post": {"summary":"Persist then deliver RemoteStartTransaction. Accepted delivery is not actual charging start.", "security":[{"CMSServiceBearer":[]}], "parameters":[{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/Correlation"}], "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartCommand"}}}}, "responses":{"202":{"description":"Canonical durable command, possibly OCPP_ACCEPTED, OCPP_REJECTED, or AMBIGUOUS.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandEnvelope"}}}},"401":{"description":"Missing or invalid service credential"},"404":{"description":"No durable mapping"},"409":{"description":"Idempotency conflict"},"422":{"description":"Invalid command or mapping state"}}}},
    "/v1/remote-commands/stop": {"post": {"summary":"Persist a stop command against one exact transaction. RemoteStop acknowledgement is not completion.", "security":[{"CMSServiceBearer":[]}], "parameters":[{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/Correlation"}], "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StopCommand"}}}}, "responses":{"202":{"description":"Canonical durable stop command; completion still requires StopTransaction.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StopCommandEnvelope"}}}},"401":{"description":"Missing or invalid service credential"},"404":{"description":"Unknown or mismatched transaction/mapping"},"409":{"description":"Idempotency conflict"},"422":{"description":"Invalid or expired stop command"}}}},
    "/v1/remote-commands": {"get": {"summary":"Reconcile one durable command by exact CMS command ID", "security":[{"CMSServiceBearer":[]}], "parameters":[{"name":"cms_command_id","in":"query","required":true,"schema":{"type":"string","format":"uuid"}}], "responses":{"200":{"description":"Canonical command state.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandEnvelope"}}}},"404":{"description":"Unknown command"}}}},
    "/v1/transactions": {"get": {"summary":"Reconcile a materialized OCPP transaction by exact CMS start intent", "security":[{"CMSServiceBearer":[]}], "parameters":[{"name":"cms_start_intent_id","in":"query","required":true,"schema":{"type":"string","format":"uuid"}}], "responses":{"200":{"description":"HAL transaction truth","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransactionEnvelope"}}}},"404":{"description":"Not materialized or unknown"}}}},
    "/v1/transactions/{hal_transaction_id}": {"get": {"summary":"Reconcile a transaction by exact HAL identity", "security":[{"CMSServiceBearer":[]}], "parameters":[{"name":"hal_transaction_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}], "responses":{"200":{"description":"HAL transaction truth","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransactionEnvelope"}}}},"404":{"description":"Unknown transaction"}}}},
    "/v1/runtime/chargers/{charger_ocpp_identity}": {"get": {"summary":"Get connection truth and mapped connector states. Connector status is fresh only when connection_state is ONLINE.", "security":[{"CMSServiceBearer":[]}], "parameters":[{"name":"charger_ocpp_identity","in":"path","required":true,"schema":{"type":"string"}}], "responses":{"200":{"description":"Runtime snapshot","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChargerRuntimeEnvelope"}}}},"404":{"description":"Unknown mapping/runtime"}}}},
    "/v1/runtime/connectors/{cms_connector_id}": {"get": {"summary":"Get exact mapped connector OCPP status and freshness", "security":[{"CMSServiceBearer":[]}], "parameters":[{"name":"cms_connector_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}], "responses":{"200":{"description":"Connector runtime","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConnectorRuntimeEnvelope"}}}},"404":{"description":"Unknown connector mapping"}}}}
  }
}
