# Independent OCPP HAL for ev-cms-backend-new.
# Allowed values: development (default), test, production. Unknown values
# fail startup; production never reads a local .env file.
HAL_ENVIRONMENT=development
F_SERVER_HOST=127.0.0.1
F_SERVER_PORT=18080

# OCPP central system
OCPP_LISTEN_PORT=18081
OCPP_LISTEN_PATH=/{ws}
# Requested OCPP Heartbeat cadence. CMS connection freshness must remain
# comfortably longer than this cadence; allowed range is 1..86400 and the
# coordinated v1 default is 300s.
OCPP_HEARTBEAT_INTERVAL_SECONDS=300

# Required CMS-to-HAL service identity. Generate a unique opaque value locally.
HAL_V1_CMS_BEARER_TOKEN=replace-with-a-random-opaque-service-token

# Optional HAL-to-CMS immutable fact delivery. Enable only with an approved
# authenticated receiver; the receiver is not a customer-facing endpoint.
HAL_V1_FACT_DELIVERY_ENABLED=false
HAL_V1_CMS_FACTS_URL=
HAL_V1_CMS_FACT_BEARER_TOKEN=replace-with-a-separate-random-service-token

# Diagnostic trace evidence only. Retention never removes transaction, command,
# connector, or fact state.
HAL_V1_TRACE_RETENTION_DAYS=30
HAL_V1_TRACE_RETENTION_INTERVAL_SECONDS=3600

# Required only by cmd/migrate. It is the non-privileged application/schema
# role under which reviewed DDL is executed; never hardcode a deployment role.
HAL_MIGRATION_APPLICATION_ROLE=

# API documentation is disabled unless explicitly requested locally.
API_DOCS_ENABLED=false
LOG_LEVEL=info

# PostgreSQL is required for every HAL runtime. DATABASE_URL takes precedence.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ocppgo
DB_USER=ocppgodbadmin
DB_PASSWORD=replace-me
DB_SSLMODE=disable

# Optional standalone virtual charge point defaults.
CP_SIM_URL=ws://127.0.0.1:18081
CP_SIM_ID=CP-SIM-001
CP_SIM_MODEL=TransEV-Simulator
CP_SIM_VENDOR=TransEV
CP_SIM_CONNECTOR=1
CP_SIM_METER_START_WH=100000
CP_SIM_VOLTAGE=230
CP_SIM_SOC=35
