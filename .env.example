# REST API
HAL_ENVIRONMENT=development
HAL_V1_ENABLED=false
F_SERVER_HOST=127.0.0.1
F_SERVER_PORT=18080

# OCPP central system
OCPP_LISTEN_PORT=18081
OCPP_LISTEN_PATH=/{ws}

# API auth
API_KEY=testkey
APIAUTHKEY=replace-me

# New CMS -> HAL v1 service auth. Required only when HAL_V1_ENABLED=true.
HAL_V1_CMS_BEARER_TOKEN=replace-with-a-random-opaque-service-token

# API documentation is disabled unless explicitly requested locally.
API_DOCS_ENABLED=false

# Logging
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ocppgo
DB_USER=ocppgodbadmin
DB_PASSWORD=replace-me
DB_SSLMODE=disable

# Legacy CMS hooks. Safe local placeholders only; do not point this checkout at
# inherited production CMS endpoints.
MAIN_CMS_START_TXN_HOOK_URL=http://127.0.0.1:1/legacy-disabled/start
MAIN_CMS_COMPLETED_TXN_URL=http://127.0.0.1:1/legacy-disabled/completed

# Single-session CMS hooks
SINGLE_SESSION_START_TXN_HOOK_URL=http://127.0.0.1:1/legacy-disabled/start
SINGLE_SESSION_COMPLETED_TXN_URL=http://127.0.0.1:1/legacy-disabled/completed

# Charger directory endpoint
APICHARGERDATA=
CHARGER_DATA_CACHE_TTL_SECONDS=7200

# Local mock hooks
MOCK_HOOK_ADDR=127.0.0.1:19090
MOCK_START_MAX_KWH=7.5
MOCK_CHARGER_IDS=CP-REG-CORE-001,CP-REG-SINGLE-001,CP-REG-LIMIT-001,CP-REG-OFFLINE-001

# Optional standalone cpconsole defaults. Command-line flags override these.
CP_SIM_URL=ws://127.0.0.1:18081
CP_SIM_ID=CP-SIM-001
CP_SIM_MODEL=TransEV-Simulator
CP_SIM_VENDOR=TransEV
CP_SIM_CONNECTOR=1
CP_SIM_METER_START_WH=100000
CP_SIM_VOLTAGE=230
CP_SIM_SOC=35
